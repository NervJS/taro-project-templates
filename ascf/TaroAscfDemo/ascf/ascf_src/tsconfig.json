{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "target": "es5",
    "module": "commonjs",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "noImplicitAny": false,
    "strict": true,
    "rootDir": ".",
    "noEmit": true,
    "typeRoots": [
      "./node_modules/@types",
      "../build/ascf-api-typings"
    ]
  },
  "include": [
    "./**/*.js"
  ],
  "exclude": [
    "node_modules"
  ]
}